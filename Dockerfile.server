ARG RUST_IMAGE=rust:1.99-trixie
FROM ${RUST_IMAGE} AS builder

RUN apt-get update \
    && apt-get install --yes --no-install-recommends libprotobuf-dev musl-tools protobuf-compiler \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /workspace
ARG TARGETPLATFORM
RUN case "${TARGETPLATFORM}" in \
      linux/amd64) echo x86_64-unknown-linux-musl > /tmp/rust-target ;; \
      linux/arm64) echo aarch64-unknown-linux-musl > /tmp/rust-target ;; \
      *) echo "Unsupported target platform: ${TARGETPLATFORM}" >&2; exit 1 ;; \
    esac

COPY . .

RUN rustup target add "$(cat /tmp/rust-target)"

ARG SERVER=kv
RUN case "${SERVER}" in \
      kv) package=ofdb-kv-server-cli; binary=kv-server-cli ;; \
      sql) package=ofdb-sql-server-cli; binary=sql-server-cli ;; \
      *) echo "SERVER must be kv or sql" >&2; exit 1 ;; \
    esac \
    && cargo build --locked --release --target "$(cat /tmp/rust-target)" -p "${package}" \
    && install -D "target/$(cat /tmp/rust-target)/release/${binary}" /out/server \
        && install -d /out/data

FROM scratch
LABEL org.opencontainers.image.source="https://github.com/nathanfaucett/rs-ofdb"
COPY --from=builder /out/server /server
COPY --from=builder --chown=65532:65532 /out/data /data

USER 65532:65532
ENV OFDB_DATA=/data/ofdb.redb
VOLUME ["/data"]
EXPOSE 8080 8081
ENTRYPOINT ["/server"]
