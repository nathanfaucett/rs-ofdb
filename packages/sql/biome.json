{
  "$schema": "https://biomejs.dev/schemas/2.6.4/schema.json",
  "linter": {
    "enabled": true,
    "includes": ["src/**"],
    "rules": {
      "preset": "recommended",
      "style": {
        "useImportType": "error",
        "useConst": "error",
        "noParameterProperties": "error"
      },
      "correctness": {
        "noUnusedVariables": "error",
        "noUnusedImports": "error"
      },
      "suspicious": {
        "noExplicitAny": "error",
        "noImplicitAnyLet": "error"
      },
      "complexity": {
        "noThisInStatic": "error",
        "useLiteralKeys": "error"
      },
      "nursery": {
        "useAwaitThenable": "error"
      }
    }
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "double",
      "semicolons": "always"
    }
  }
}
