{
  "name": "@ofsdk/ofdb-browser-example",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Svelte + Tailwind browser example for @ofsdk/kv and @ofsdk/sql (KV + SQL over IndexedDB)",
  "scripts": {
    "dev": "portless ofdb-example vite dev",
    "build": "vite build",
    "preview": "portless ofdb-example vite preview",
    "check": "svelte-check --tsconfig ./tsconfig.json",
    "lint": "biome check src/",
    "lint:fix": "biome check --write src/",
    "test": "playwright test smoke.test.ts"
  },
  "dependencies": {
    "@ofsdk/kv": "file:../kv",
    "@ofsdk/sql": "file:../sql"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.3",
    "@playwright/test": "1.49.0",
    "@sveltejs/vite-plugin-svelte": "^7.2.0",
    "@tailwindcss/vite": "^4.3.3",
    "portless": "^0.15.4",
    "svelte": "^5.56.8",
    "svelte-check": "^4.7.4",
    "tailwindcss": "^4.3.3",
    "typescript": "5.9.3",
    "vite": "^8.2.0"
  }
}
