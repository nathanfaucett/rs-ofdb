{
  "name": "@ofdb/monorepo",
  "private": true,
  "type": "module",
  "scripts": {
    "test": "pnpm -r run test",
    "lint": "pnpm -r run lint",
    "lint:fix": "pnpm -r run lint:fix",
    "format": "pnpm -r run format",
    "format:fix": "pnpm -r run format:fix",
    "packages:build": "pnpm --filter \"./packages/*\" run build",
    "db:build": "pnpm --filter @of/db run build",
    "example:build": "pnpm --filter ofdb-browser-example run build"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.3"
  },
  "pnpm": {
    "overrides": {
      "wasm-pack@*": "0.13.1"
    }
  }
}
