{
  "name": "@ofsdk/monorepo",
  "private": true,
  "type": "module",
  "scripts": {
    "test": "pnpm -r run test",
    "lint": "pnpm -r run lint",
    "lint:fix": "pnpm -r run lint:fix",
    "format": "pnpm -r run format",
    "format:fix": "pnpm -r run format:fix",
    "packages:build": "pnpm --filter \"./packages/*\" run build",
    "kv:build": "pnpm --filter @ofsdk/kv run build",
    "sql:build": "pnpm --filter @ofsdk/sql run build",
    "example:dev": "pnpm --filter @ofsdk/ofdb-browser-example run dev",
    "example:build": "pnpm --filter @ofsdk/ofdb-browser-example run build",
    "example:preview": "pnpm --filter @ofsdk/ofdb-browser-example run preview",
    "example:check": "pnpm --filter @ofsdk/ofdb-browser-example run check",
    "example:test": "pnpm --filter @ofsdk/ofdb-browser-example run test"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.3"
  },
  "pnpm": {
    "overrides": {
      "wasm-pack@*": "0.13.1"
    }
  }
}
